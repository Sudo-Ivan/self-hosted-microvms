DESCRIPTION="Widelands realtime strategy dedicated server"
MEM_MIB=1024
VCPU_COUNT=2
DATA_SIZE_MIB=4096
ROOTFS_SIZE_MIB=2048
PORT_FORWARDS=7396:7396
PACKAGES="ca-certificates curl widelands"
TAGS=games
DATA_HINT=/data/widelands
HARDEN=setpriv
NOTES="Uses Alpine widelands. Dedicated mode on TCP 7396. Saves under /data/widelands."

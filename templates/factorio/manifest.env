DESCRIPTION="Factorio headless server (dynamic stable download)"
MEM_MIB=2048
VCPU_COUNT=2
DATA_SIZE_MIB=8192
ROOTFS_SIZE_MIB=3072
PORT_FORWARDS=34197:34197:udp
PACKAGES="ca-certificates curl python3 tar xz gcompat"
TAGS=games
DATA_HINT=/data/factorio
HARDEN=setpriv
NOTES="Resolves latest Factorio headless unless FACTORIO_VERSION is set. Uses gcompat for glibc binary on Alpine. Place save.zip under /data/factorio/saves. UDP 34197."

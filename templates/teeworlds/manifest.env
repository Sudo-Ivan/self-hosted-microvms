DESCRIPTION="Teeworlds retro multiplayer shooter server (dynamic release)"
MEM_MIB=512
VCPU_COUNT=1
DATA_SIZE_MIB=2048
ROOTFS_SIZE_MIB=1536
PORT_FORWARDS=8303:8303:udp
PACKAGES="ca-certificates curl python3 tar gcompat"
TAGS=games
DATA_HINT=/data/teeworlds
HARDEN=setpriv
NOTES="Resolves latest teeworlds linux_x86_64 release unless TEEWORLDS_VERSION is set. Uses gcompat on Alpine. UDP 8303."

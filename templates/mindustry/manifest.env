DESCRIPTION="Mindustry tower-defense sandbox server (dynamic GitHub release)"
MEM_MIB=1024
VCPU_COUNT=2
DATA_SIZE_MIB=4096
ROOTFS_SIZE_MIB=2048
PORT_FORWARDS=6567:6567
PACKAGES="ca-certificates curl python3 tar"
TAGS=games
DATA_HINT=/data/mindustry
HARDEN=setpriv
NOTES="Resolves latest Anuken/Mindustry server-release.jar unless MINDUSTRY_VERSION is set. Java from Adoptium. Config/saves under /data/mindustry."

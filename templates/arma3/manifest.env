DESCRIPTION="Arma 3 dedicated server with HTML mod presets and Steam workshop sync"
MEM_MIB=8192
VCPU_COUNT=4
DATA_SIZE_MIB=102400
ROOTFS_SIZE_MIB=5120
PORT_FORWARDS=2302:2302:udp,2303:2303:udp,2304:2304:udp,2305:2305:udp,2306:2306:udp
PACKAGES="ca-certificates curl git bash python3 py3-pip python3-dev gcc g++ musl-dev libffi-dev openssl-dev zlib-dev gcompat"
TAGS=games
DATA_HINT=/data/arma3
HARDEN=off
HEALTH_WAIT_SECS=900
NOTES="Uses frederik-hoeft/Arma3Server (PR #97 style CDN sync). Set STEAM_USER and STEAM_PASSWORD via mvm secrets. Steam Guard must be off on that account. MODS_PRESET can be a URL or path under /data/arma3 (e.g. presets/mods.html). Workshop cache: /data/arma3/cache. Server files: /data/arma3/server. First start downloads the Linux server and mods (large, slow). SKIP_INSTALL=true skips depot sync after the first successful install."

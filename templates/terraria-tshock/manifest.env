DESCRIPTION="Terraria TShock server (dynamic GitHub release)"
MEM_MIB=1024
VCPU_COUNT=2
DATA_SIZE_MIB=4096
ROOTFS_SIZE_MIB=2048
PORT_FORWARDS=7777:7777
PACKAGES="ca-certificates curl python3 tar unzip libstdc++ gcompat icu-libs"
TAGS=games
DATA_HINT=/data/tshock
HARDEN=setpriv
NOTES="Resolves latest Pryaxis/TShock linux-x64 zip unless TSHOCK_VERSION is set. Uses gcompat for .NET on Alpine. World data under /data/tshock. TCP 7777."

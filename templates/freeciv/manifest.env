DESCRIPTION="FreeCiv empire-building strategy game server"
MEM_MIB=512
VCPU_COUNT=1
DATA_SIZE_MIB=2048
ROOTFS_SIZE_MIB=1536
PORT_FORWARDS=5556:5556
PACKAGES="ca-certificates curl freeciv-server freeciv-data"
TAGS=games
DATA_HINT=/data/freeciv
HARDEN=setpriv
NOTES="Uses Alpine freeciv-server. Saves under /data/freeciv. Default port 5556."

DESCRIPTION="Fabric Minecraft server (dynamic Fabric meta)"
MEM_MIB=2048
VCPU_COUNT=2
DATA_SIZE_MIB=8192
ROOTFS_SIZE_MIB=3072
PORT_FORWARDS=25565:25565
PACKAGES="ca-certificates curl python3 tar"
TAGS=games,minecraft
DATA_HINT=/data/minecraft
HARDEN=setpriv
HEALTH_WAIT_SECS=300
NOTES="Resolves stable Fabric game/loader/installer unless MC_VERSION, FABRIC_LOADER, or FABRIC_INSTALLER is set. Java from Adoptium. Mods go in /data/minecraft/mods. Accepts EULA on first boot."

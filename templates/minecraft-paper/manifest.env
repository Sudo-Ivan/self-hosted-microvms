DESCRIPTION="Paper Minecraft server (dynamic Fill v3 build)"
MEM_MIB=2048
VCPU_COUNT=2
DATA_SIZE_MIB=8192
ROOTFS_SIZE_MIB=3072
PORT_FORWARDS=25565:25565
PACKAGES="ca-certificates curl python3 tar"
TAGS=games,minecraft
DATA_HINT=/data/minecraft
HARDEN=setpriv
HEALTH_WAIT_SECS=300
NOTES="Resolves latest Paper build via fill.papermc.io unless MC_VERSION is set. Prefers STABLE channel. Java from Adoptium. Accepts EULA on first boot. Plugins go in /data/minecraft/plugins."

DESCRIPTION="Minetest / Luanti voxel game server"
MEM_MIB=1024
VCPU_COUNT=2
DATA_SIZE_MIB=8192
ROOTFS_SIZE_MIB=1536
PORT_FORWARDS=30000:30000:udp
PACKAGES="ca-certificates curl minetest-server"
TAGS=games
DATA_HINT=/data/minetest
HARDEN=setpriv
NOTES="Uses Alpine minetest-server (no pinned version). World and config under /data/minetest. UDP 30000."

DESCRIPTION="OpenTTD transport tycoon dedicated server (dynamic release)"
MEM_MIB=1024
VCPU_COUNT=2
DATA_SIZE_MIB=4096
ROOTFS_SIZE_MIB=2048
PORT_FORWARDS=3979:3979:udp
PACKAGES="ca-certificates curl python3 tar xz unzip gcompat"
TAGS=games
DATA_HINT=/data/openttd
HARDEN=setpriv
NOTES="Resolves latest OpenTTD + OpenGFX unless OPENTTD_VERSION is set. Uses gcompat on Alpine. UDP 3979."

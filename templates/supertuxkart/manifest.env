DESCRIPTION="SuperTuxKart online racing dedicated server"
MEM_MIB=1024
VCPU_COUNT=2
DATA_SIZE_MIB=4096
ROOTFS_SIZE_MIB=2048
PORT_FORWARDS=2759:2759:udp
PACKAGES="ca-certificates curl supertuxkart-server"
TAGS=games
DATA_HINT=/data/supertuxkart
HARDEN=setpriv
NOTES="Uses Alpine supertuxkart-server. UDP 2759. Config under /data/supertuxkart."

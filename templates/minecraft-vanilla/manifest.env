DESCRIPTION="Vanilla Minecraft Java server (dynamic Mojang release)"
MEM_MIB=2048
VCPU_COUNT=2
DATA_SIZE_MIB=8192
ROOTFS_SIZE_MIB=3072
PORT_FORWARDS=25565:25565
PACKAGES="ca-certificates curl python3 tar"
TAGS=games,minecraft
DATA_HINT=/data/minecraft
HARDEN=setpriv
HEALTH_WAIT_SECS=300
NOTES="Resolves latest Mojang release unless MC_VERSION is set. Java comes from Adoptium. Accepts EULA on first boot. Override MC_XMS/MC_XMX for heap. No HTTP health endpoint."

DESCRIPTION="Xonotic fast-paced FPS dedicated server"
MEM_MIB=1024
VCPU_COUNT=2
DATA_SIZE_MIB=4096
ROOTFS_SIZE_MIB=2048
PORT_FORWARDS=26000:26000:udp
PACKAGES="ca-certificates curl xonotic-server"
TAGS=games
DATA_HINT=/data/xonotic
HARDEN=setpriv
NOTES="Uses Alpine xonotic-server. Config under /data/xonotic. UDP 26000."
